# .env.local 로 복사해서 채우세요. Vercel 에도 같은 값 2개를 등록합니다.
# anon key 는 공개돼도 되는 키입니다. service role key 는 쓰지 않습니다 (TRD §9).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# 도메인 연결 후 실제 주소로. 미설정 시 https://taro108.vercel.app
# NEXT_PUBLIC_SITE_URL=https://taro108.kr
